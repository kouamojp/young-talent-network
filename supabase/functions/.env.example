# Secrets des Edge Functions (jamais exposés au navigateur). Détails : ENVIRONMENT.md
# Local : lu automatiquement par `supabase functions serve`.
# Production : supabase secrets set --env-file supabase/functions/.env

# IA : une clé suffit. KIMI_API_KEY est réservée à l'Assistant IA (Kimi K3).
# Clé complète, préfixe sk- compris.
KIMI_API_KEY=""
HAIMAKER_API_KEY=""
# MOONSHOT_API_KEY=""
# OPENROUTER_API_KEY=""
# LOVABLE_API_KEY=""
# Valeurs possibles : moonshot | haimaker | openrouter | lovable
# AI_PROVIDER="moonshot"

# Connexion Telegram (@BotFather). Nom du bot sans @.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Accord parental (13-14 ans) : envoi de l'e-mail au parent via Resend.
# L'adresse d'expéditeur doit appartenir à un domaine vérifié dans Resend.
RESEND_API_KEY=""
CONSENT_EMAIL_FROM="YAT <noreply@votre-domaine.com>"
# URL publique de l'application, sans / final (utilisée dans le lien de l'e-mail).
APP_URL="https://votre-domaine.com"
